# Default 33-scenario reference benchmark; model runs must be started explicitly. For actual Jira issues in your own project, see QUICKSTART section 5.
# SPINE_REPO is the Spine tool/reference checkout, not your application repository.
# Copy to .env. Edit SPINE_REPO, then source .env from the unpacked harness directory.
export SPINE_REPO="$HOME/code/spine"

# Each experiment needs fresh work and results directories. Run setup again after changing them.
# Use an absolute WORK_DIR outside your home directory, with an existing parent.
export WORK_DIR="/tmp/speckit-bench-${USER:-team}-run1"
export RESULTS_DIR="$PWD/results/run1"

# Dedicated harness credentials live outside both the package and results.
export CODEX_LOGIN_HOME="/tmp/speckit-codex-login-${USER:-team}"
export CODEX_AUTH=app
export SPINE_BACKEND=codex
export CODEX_REASONING_EFFORT=high
export CODEX_OUTPUT_MODE=envelope
export MODEL=gpt-6-sol

# Clear API credentials for the subscription-only workflow.
unset OPENAI_API_KEY ANTHROPIC_API_KEY CODEX_API_KEY CODEX_ACCESS_TOKEN

export UV_PYTHON=3.12
export UV_CACHE_DIR="$WORK_DIR/uv-cache"
export TARGET_SHA=bd16dbb7d2451bfaffa94c02946972050e23a610
export SPINE_REF=v3.52.0
export SPECKIT_REF=v1.0.11
export TICKETS=NEW-SEVSUMMARY-1,NEW-LEDGERMD-1,NEW-DRIFTMD-1,EXT-REACH-1,EXT-PATH-1,EXT-IMPACT-1,EXT-COMPONENTS-1,EXT-LAYERS-1,EXT-SCC-1,EXT-DANGLING-1,EXT-BALANCE-1,EXT-LANGUAGE-1,EXT-LEAVES-1,EXT-DUPCOL-1,EXT-FKCHECK-1,EXT-DBORDER-1,EXT-SCHEMADIFF-1,EXT-REQUIRED-1,EXT-RANGES-1,EXT-FILECOVER-1,EXT-LOCATE-1,EXT-AMBIGUOUS-1,EXT-TOUCHED-1,EXT-MEDIAN-1,EXT-SHARE-1,EXT-MERGEFREQ-1,EXT-RANK-1,EXT-ALLOCATE-1,EXT-HANDLERS-1,EXT-ORPHANDOC-1,EXT-INTENTS-1,EXT-CUT-1,EXT-OWNERS-1
# Optional one-ticket smoke pilot (set before setup/validation):
# export TICKETS=NEW-SEVSUMMARY-1

# Bundled catalog adds 30 tasks to the stock catalog. Unset also uses this catalog.
export SCENARIO_FILE="$PWD/catalog/expanded.json"
# To use your own catalog, select it AND explicitly choose its ticket IDs:
# export SCENARIO_FILE="$PWD/team-scenarios/scenarios.json"
# export TICKETS=CUSTOM-EDIT-RANGE-1,CUSTOM-NEW-HISTOGRAM-1
